{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.krupaelevators.com" }],
      "destination": "https://krupaelevators.com/:path",
      "permanent": true
    },
    { "source": "/Krupa-Elevators", "destination": "/", "permanent": true },
    { "source": "/Krupa-Elevators/:path(.*)", "destination": "/:path", "permanent": true },
    { "source": "/KrupaElevator", "destination": "/", "permanent": true },
    { "source": "/KrupaElevator/:path(.*)", "destination": "/:path", "permanent": true },
    { "source": "/elevators", "destination": "/products/elevators", "permanent": true },
    { "source": "/elevators/:id", "destination": "/products/elevators/:id", "permanent": true },
    { "source": "/doors", "destination": "/products/doors", "permanent": true },
    { "source": "/doors/:category/:id", "destination": "/products/doors/:id", "permanent": true },
    { "source": "/interiors", "destination": "/products/interiors", "permanent": true },
    { "source": "/interiors/:id", "destination": "/products/interiors/:id", "permanent": true },
    { "source": "/interior", "destination": "/products/interiors", "permanent": true },
    { "source": "/technology", "destination": "/products/technology", "permanent": true },
    { "source": "/technologies", "destination": "/products/technology", "permanent": true },
    { "source": "/architects-corner", "destination": "/products/architects-corner", "permanent": true },
    { "source": "/civil-drawings", "destination": "/products/architects-corner", "permanent": true },
    { "source": "/drawings", "destination": "/products/architects-corner", "permanent": true },
    { "source": "/specifications", "destination": "/products/elevators", "permanent": true },
    { "source": "/service", "destination": "/services", "permanent": true },
    { "source": "/projects", "destination": "/about/projects", "permanent": true },
    { "source": "/about/clients", "destination": "/clients", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)\\.woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*)\\.(jpg|jpeg|png|webp|svg|gif|avif|pdf)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.ico|favicon-32x32.png|favicon-48x48.png|favicon-96x96.png|icon-192.png|icon-512.png|apple-touch-icon.png|site.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
